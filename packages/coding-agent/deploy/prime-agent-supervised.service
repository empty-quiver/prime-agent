[Unit]
Description=Prime Agent anchored-session supervisor
StartLimitIntervalSec=1800
StartLimitBurst=10

[Service]
Type=exec
NotifyAccess=all
WorkingDirectory=/opt/prime-agent
Environment=PRIME_AGENT_KERNEL_SYSTEMD=1
Environment=PRIME_AGENT_SUPERVISOR_UNIT=prime-agent-supervised.service
Environment=PRIME_AGENT_KERNEL_PYTHON=/opt/prime-agent-python/bin/python
Environment=PI_SKIP_VERSION_CHECK=1
Environment=PRIME_AGENT_INSTALL_UV=0
UMask=0077
ExecStart=/opt/prime-agent/bin/node --max-old-space-size=4096 --import /opt/prime-agent/node_modules/tsx/dist/loader.mjs /opt/prime-agent/packages/coding-agent/src/cli/supervised-agent.ts %h/.config/prime-agent-supervised/config.json
Restart=on-failure
RestartPreventExitStatus=78
RestartSec=5s
RestartSteps=6
RestartMaxDelaySec=300s
TimeoutStartSec=90s
TimeoutStopSec=45s
WatchdogSec=30s
KillMode=control-group
SendSIGKILL=yes
MemoryHigh=5G
MemoryMax=6G
TasksMax=512

[Install]
WantedBy=default.target
